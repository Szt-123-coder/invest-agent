# 复制成 .env 再填。.env 已在 .gitignore 里，不会被提交。
# 不填 LLM_API_KEY 就是演示模式：假模型 + 示例数据，不花钱。

# 大模型（任何兼容 OpenAI 接口的服务都行，默认 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 评测时的裁判模型，不填就用上面的
JUDGE_MODEL=

# 新闻搜索，不填就用示例新闻
TAVILY_API_KEY=

# 设了之后，只有输入这个密码的人才用真模型；其他访客自动用演示模式
ACCESS_PASSWORD=

# 每隔几分钟检查一次提醒（0 = 不检查），触发后用 PushPlus 推到微信
SCHEDULER_MINUTES=15
PUSHPLUS_TOKEN=

DATABASE_URL=sqlite:///data/invest_agent.db
TIMEZONE=Australia/Sydney
